action_text = "Revisar el escritorio"
lines = PackedStringArray("Recibos de luz, agua y gas. Todos vencen esta semana.", "Una nota: «Pagar el arriendo el 5». Hoy no es el 5, respira.")

[node name="TvRemote" type="Area2D" parent="World/Interactables" parent_id_path=PackedInt32Array(1886078809) unique_id=1940099285]
position = Vector2(478, 214)
